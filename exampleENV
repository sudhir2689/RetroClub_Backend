# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clerk Authentication (From your Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin Privileges (Comma-separated emails to grant admin access upon sync)
ADMIN_EMAILS=your-admin-email@gmail.com

# Cloudinary (From Cloudinary Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (From Razorpay Dashboard -> Settings -> API Keys [Test Mode])
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret